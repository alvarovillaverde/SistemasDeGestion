---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

// Leemos la entrada 'proyectos' dentro de la colección 'projects'
const entry = await getEntry('projects', 'proyectos');

if (!entry) {
  throw new Error("No se encontró el archivo proyectos.mdx en src/content/projects/");
}

const { Content } = await render(entry);
---

<BaseLayout>
  <div class="proyectos-container">
    <Content />
  </div>
</BaseLayout>

<style>
  .proyectos-container {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 2rem;
    color: #1e293b;
  }
</style>