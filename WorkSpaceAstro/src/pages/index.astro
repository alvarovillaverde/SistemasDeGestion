---
import Card from "../components/Card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// se ejecuta en el servidor
const nombre = "Fermin";
const luchadoresUFC = [
	"Alexander Volkanovsky",
	"Khamzat Chimaev",
	"Jon Jones",
	"Alexandre Pantoja",
	"Kevin Vallejos",
];
---

<BaseLayout title="Mi Portafolio - Inicio">
	<script>
		const valor = 5;
	</script>
	<style>
		h1 {
			color: #4f4f4f;
			text-align: center;
			font-size: xx-large;
		}
	</style>

	<h1>Mi primera pagina en astro</h1>
	<p>Yo me llamo {nombre}</p>
	<h2>Luchadores UFC top pero random</h2>
	<ul>
		{luchadoresUFC.map((luchador) => <li>{luchador}</li>)}
	</ul>
	<Card imagen="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSlpILPAgyLslwF8VCcmMe14kQVGPSDNJz6e1ji-gVt8lJcx-Y3czkqa2w&s=10" 
	titulo="El mejor de la historia" texto="Doble campeon, media vida peleando en la mejor division del mundo y sin una derrota"/>
</BaseLayout>
