---
const { imagen, titulo, texto } = Astro.props;
---

<div>
  <!-- Imagen y Título al lado -->
  <div>
    <img src={imagen} />
    <h2>{titulo}</h2>
  </div>

  <!-- Texto debajo de ambos -->
  <p>{texto}</p>
</div>

<style>
  div {
    border: 1px solid #ccc;
    padding: 16px;
    max-width: 400px;
  }

  div > div {
    display: flex;
    align-items: center;
    gap: 15px;
    border: none;
    padding: 0;
  }

  img {
    width: 100px;
    height: 100px;
    object-fit: cover;
  }

  h2 {
    margin: 0;
    font-size: 24px;
  }

  p {
    margin-top: 15px;
    margin-bottom: 0;
  }
</style>
