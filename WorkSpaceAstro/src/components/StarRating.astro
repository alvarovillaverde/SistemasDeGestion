---
interface Props {
  projectId: string;
}

const { projectId } = Astro.props;
---

<div class="star-rating" data-project-id={projectId}>
  <span class="rating-label">Valorar proyecto:</span>
  <div class="stars">
    <button type="button" class="star" data-value="1" aria-label="1 estrella">★</button>
    <button type="button" class="star" data-value="2" aria-label="2 estrellas">★</button>
    <button type="button" class="star" data-value="3" aria-label="3 estrellas">★</button>
    <button type="button" class="star" data-value="4" aria-label="4 estrellas">★</button>
    <button type="button" class="star" data-value="5" aria-label="5 estrellas">★</button>
  </div>
  <span class="rating-status"></span>
</div>

<script>
  // Función con tipos declarados para quitar los subrayados rojos de TypeScript
  function highlightStars(starsNodeList: NodeListOf<HTMLButtonElement>, value: number): void {
    starsNodeList.forEach((star: HTMLButtonElement) => {
      const starVal = parseInt(star.getAttribute('data-value') || '0', 10);
      if (starVal <= value) {
        star.classList.add('active');
      } else {
        star.classList.remove('active');
      }
    });
  }

  // Inicializar todas las valoraciones en la página
  function initRatings(): void {
    const containers = document.querySelectorAll<HTMLElement>('.star-rating');

    containers.forEach((container) => {
      const projectId = container.getAttribute('data-project-id');
      if (!projectId) return;

      const stars = container.querySelectorAll<HTMLButtonElement>('.star');
      const status = container.querySelector<HTMLElement>('.rating-status');

      // 1. Cargar la valoración guardada previamente en localStorage
      const savedRating = localStorage.getItem(`rating_${projectId}`);
      if (savedRating) {
        const numericRating = parseInt(savedRating, 10);
        highlightStars(stars, numericRating);
        if (status) status.textContent = `(Tu nota: ${numericRating}/5)`;
      }

      // 2. Asignar eventos a cada estrella
      stars.forEach((star) => {
        // Al hacer clic: Guardar en localStorage y actualizar pantalla
        star.addEventListener('click', () => {
          const val = parseInt(star.getAttribute('data-value') || '0', 10);
          localStorage.setItem(`rating_${projectId}`, val.toString());
          highlightStars(stars, val);
          if (status) status.textContent = `¡Guardado! (${val}/5)`;
        });

        // Al pasar el ratón (Hover)
        star.addEventListener('mouseenter', () => {
          const val = parseInt(star.getAttribute('data-value') || '0', 10);
          highlightStars(stars, val);
        });
      });

      // Al sacar el ratón: Volver a la nota que está guardada en localStorage
      container.addEventListener('mouseleave', () => {
        const currentRating = localStorage.getItem(`rating_${projectId}`);
        highlightStars(stars, currentRating ? parseInt(currentRating, 10) : 0);
      });
    });
  }

  // Ejecutar al cargar la página
  document.addEventListener('DOMContentLoaded', initRatings);
</script>

<style>
  .star-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1rem 0;
    padding: 0.6rem 1rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-family: inherit;
  }

  .rating-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #334155;
  }

  .stars {
    display: flex;
    gap: 0.2rem;
  }

  .star {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: #cbd5e1;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .star:hover {
    transform: scale(1.2);
  }

  .star.active {
    color: #f59e0b;
  }

  .rating-status {
    font-size: 0.85rem;
    color: #64748b;
  }
</style>