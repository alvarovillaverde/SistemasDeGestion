<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Sitio Web</title>
</head>
<body>
    <header class="navbar">
        <nav>
            <a href="/">Inicio</a>
            <a href="/index2">Página 2</a>
        </nav>
    </header>

    <main class="container">
        <slot />
    </main>
</body>
</html>

<style is:global>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: var(--bg-color, #f4f4f9);
        color: var(--text-color, #333333);
        line-height: 1.6;
        min-height: 100vh;
        transition: background-color 0.2s ease;
    }

    .navbar {
        background-color: var(--card-bg, #ffffff);
        border-bottom: 1px solid var(--border-color, #dddddd);
        padding: 1rem 0;
        margin-bottom: 2rem;
    }

    .navbar nav {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 1rem;
        display: flex;
        gap: 1.5rem;
    }

    .navbar a {
        color: #0066cc;
        text-decoration: none;
        font-weight: bold;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    h1 {
        font-size: 2rem;
        margin-bottom: 1rem;
    }

    h2 {
        font-size: 1.4rem;
        margin: 1.5rem 0 0.5rem;
    }
</style>