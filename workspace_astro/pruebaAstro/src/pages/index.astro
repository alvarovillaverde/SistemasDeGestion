---
import Button from "../components/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const nombre = "vini jr";
const cosasFav = ["tirar del pelo", "Hacer x10", "Operaciones estéticas"];
---

<BaseLayout>
    <!-- Checkbox oculto para alternar el estado -->
    <input type="checkbox" id="bg-toggle" class="bg-toggle" />

    <h1>Mi primera página de Astro</h1>

    <div class="card">
        <p>Yo me llamo <strong>{nombre}</strong></p>

        <h2>Hobbies</h2>
        <ul class="hobbies-list">
            {cosasFav.map(favorito => (
                <li>{favorito}</li>
            ))}
        </ul>

    </div>
    <div class="actions">
        <!-- Renderizamos el componente Button como <label> vinculado al checkbox -->
        <Button as="label" for="bg-toggle" variant="primary">
        Cambiar color de fondo
        </Button>
    </div>
</BaseLayout>

<style>
    /* Ocultamos el checkbox */
    .bg-toggle {
        display: none;
    }

    /* Cuando el checkbox se marca, cambiamos el fondo de la página */
    :has(.bg-toggle:checked) {
        --bg-color: #2c3e50;
        --card-bg: #34495e;
        --text-color: #ffffff;
        --border-color: #455a64;
    }

    .card {
        background-color: var(--card-bg, #ffffff);
        color: var(--text-color, #333333);
        border: 1px solid var(--border-color, #e0e0e0);
        border-radius: 8px;
        padding: 2rem;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .hobbies-list {
        margin-left: 1.5rem;
        margin-top: 0.5rem;
    }

    .hobbies-list li {
        margin-bottom: 0.25rem;
    }

    .actions {
        margin-top: 1.5rem;
    }
</style>